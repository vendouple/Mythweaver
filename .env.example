# ═══════════════════════════════════════════════════════════════════════════
#  Mythweaver configuration
# ═══════════════════════════════════════════════════════════════════════════
#
#  QUICK START
#    1. Copy this file to `.env` in the project root (same folder as package.json).
#    2. Fill in SECTION 1 (required): API_KEY, BASE_URL, CHAT_MODEL, IMAGE_MODEL.
#    3. Optional: pick a voice backend in SECTION 4 (self-hosted or paid API).
#    4. `npm run dev`, then open http://localhost:3000 on the TV.
#
#  Everything below SECTION 4 has sensible defaults — leave it alone unless you
#  are tuning a flaky provider. Restart the dev server after editing this file.
#
#  Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, Pollinations,
#  a local LM Studio / Ollama / vLLM server, ...). BASE_URL is the part BEFORE
#  `/chat/completions`, normally ending in `/v1`.
#
#  Never commit `.env` — it holds your keys. It is already in .gitignore.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  SECTION 1 — Main AI provider (REQUIRED)
# ───────────────────────────────────────────────────────────────────────────
# The storyteller (DM) model. It MUST support tool/function calling — every
# turn ends with a narrate_turn tool call.
API_KEY=
BASE_URL=https://api.openai.com/v1
CHAT_MODEL=

# Reasoning effort for CHAT_MODEL, sent as `reasoning_effort` on every call.
#   none | minimal | low | medium | high | xhigh
# Leave EMPTY to not send the field at all (provider default). Some providers
# reject unknown parameters with a 400 — if turns start failing after setting
# this, clear it. Higher = slower, costlier, usually better plotting.
CHAT_REASONING_EFFORT=

# How a call that wants ONE specific tool asks for it:
#   auto     (default) tool is offered, model chooses to call it. Most robust:
#            some backends (e.g. DeepSeek via Pollinations) answer a forced
#            choice with EMPTY arguments about half the time.
#   required model must call some tool.
#   named    model must call exactly that tool (strictest; fine on OpenAI).
TOOL_CHOICE_MODE=auto


# ───────────────────────────────────────────────────────────────────────────
#  SECTION 2 — Images (backdrops + portraits)
# ───────────────────────────────────────────────────────────────────────────
IMAGE_MODEL=
# Leave BOTH empty to reuse BASE_URL / API_KEY from Section 1. Each falls back
# independently, so you can override just the URL or just the key.
IMAGE_BASE_URL=
IMAGE_API_KEY=
# Image jobs run in the background and never block narration. After this many
# failed attempts the image is skipped (permanent 4xx errors fail immediately).
IMAGE_RETRIES=3
IMAGE_TIMEOUT_MS=60000
# Framing is automatic: backdrops 1344x768, portraits 768x1344. A provider that
# rejects `size` is retried once unsized and `size` is dropped from then on.


# ───────────────────────────────────────────────────────────────────────────
#  SECTION 3 — Housekeeping model (optional, recommended for long campaigns)
# ───────────────────────────────────────────────────────────────────────────
# A small/fast model that ONLY does chores: compacts old transcript into a
# running summary, trims memory, merges duplicate NPCs, repackages unparsable
# turns, and cleans narration for TTS. It never writes story.
# Empty = housekeeping is skipped (MAX_CONTEXT_CHARS is then the only limit).
FAST_MODEL=
# Leave BOTH empty to reuse BASE_URL / API_KEY from Section 1.
FAST_BASE_URL=
FAST_API_KEY=
# Reasoning effort for FAST_MODEL (same values as CHAT_REASONING_EFFORT).
# Chores rarely need thought — `low` or `minimal` is usually ideal. Empty = not
# sent. When FAST_MODEL is empty, chores run on CHAT_MODEL with its own effort.
FAST_REASONING_EFFORT=

# Attempts + per-attempt timeout for one sweep (it's best-effort, so it gives up
# quickly rather than stall).
HOUSEKEEPING_RETRIES=3
HOUSEKEEPING_TIMEOUT_MS=45000
# After this many consecutive failures on UNCHANGED input, sweeps pause until
# the story moves on or the party leader retries from their phone (min 1).
HOUSEKEEPING_MAX_CONSECUTIVE_FAILURES=5
# Cooldown after any failed sweep before retrying the same input (min 30000).
HOUSEKEEPING_FAILURE_COOLDOWN_MS=300000
# Unparsable DM turns are repackaged into narrate_turn by FAST_MODEL (when set)
# instead of re-running the big model. 0 = always use CHAT_MODEL for repairs.
PARSE_RETRY_USE_FAST_MODEL=1
# Time limit for the optional "clean up narration for speech" pass (ms). Slow or
# failed output falls back to local cleanup.
TTS_PREP_TIMEOUT_MS=8000


# ───────────────────────────────────────────────────────────────────────────
#  SECTION 4 — Narration voice (TTS) — pick ONE backend
# ───────────────────────────────────────────────────────────────────────────
#   local — free, self-hosted Chatterbox server in ./TTS (voice cloning from
#           the files in TTS/Voice). Needs a decent PC; a CUDA GPU is best.
#   api   — a paid hosted voice API (OpenAI-compatible /audio/speech). Nothing
#           to install; you pay the provider per character spoken.
TTS_PROVIDER=local

# ── 4a. local (Chatterbox) ──
# Setup: copy TTS/.env.example to TTS/.env, pick your hardware there, then
# double-click TTS/run_tts.bat. The folder can live on another LAN PC — then
# set the host/port from the party leader's phone (Host tab), or here.
TTS_SIDECAR_URL=http://127.0.0.1:5123
TTS_SIDECAR_TIMEOUT_MS=120000

# ── 4b. api (hosted) ──
# Defaults target OpenAI. Any provider exposing the same /audio/speech shape
# works — change the base URL, key, model and voice list to match it.
TTS_API_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
# gpt-4o-mini-tts (expressive, supports style instructions) | tts-1 | tts-1-hd
TTS_API_MODEL=gpt-4o-mini-tts
# Comma-separated voices offered in the voice picker. Empty = OpenAI's set:
#   alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse,
#   marin, cedar   (tts-1/tts-1-hd only support some of these)
TTS_API_VOICES=
# Voice used when a campaign's saved voice isn't in the list above (e.g. one
# picked while on the local backend). Empty = first voice in the list.
TTS_API_DEFAULT_VOICE=
# Optional delivery style (gpt-4o-mini-tts only; leave empty for tts-1), e.g.
#   A warm, dramatic fantasy narrator with clear diction and measured pacing.
TTS_API_INSTRUCTIONS=
# mp3 (default) | wav | opus | aac | flac
TTS_API_FORMAT=mp3
# Optional playback speed 0.25–4.0. Empty = provider default (1.0).
TTS_API_SPEED=

# Both backends: how long generated turn audio is kept in memory (ms).
TTS_BATCH_TTL_MS=300000


# ───────────────────────────────────────────────────────────────────────────
#  SECTION 5 — Backup narration models (optional)
# ───────────────────────────────────────────────────────────────────────────
# Extra models the party leader can switch to from their phone (Host tab) if
# the main one fails mid-campaign. Switching is MANUAL — nothing auto-fails
# over. Keys stay on the server; the campaign only stores the alias.
#
# Numbered 1..20. ALIAS + MODEL are required; everything else falls back to
# Section 1 (and REASONING_EFFORT to CHAT_REASONING_EFFORT).
#
#   CHAT_TARGET_1_ALIAS=gemini
#   CHAT_TARGET_1_LABEL=Gemini 3.6
#   CHAT_TARGET_1_MODEL=gemini-3.6
#   CHAT_TARGET_1_BASE_URL=https://...
#   CHAT_TARGET_1_API_KEY=...
#   CHAT_TARGET_1_REASONING_EFFORT=medium
#   CHAT_TARGET_1_TOOLS=0      # declare "can't call tools" so it's refused up front
#
# Name shown for the Section 1 model in the switcher (default: CHAT_MODEL).
CHAT_TARGET_DEFAULT_LABEL=
# Set to 0 if the Section 1 model can't call tools (narration will refuse it).
CHAT_TARGET_DEFAULT_TOOLS=


# ───────────────────────────────────────────────────────────────────────────
#  SECTION 6 — Reliability tuning (defaults are fine)
# ───────────────────────────────────────────────────────────────────────────
# DM-turn network retries + per-attempt timeout. Clamped in code to at most 10
# retries and 600000ms. Permanent 4xx errors (bad model, auth, no tool support)
# never retry; only 408/429/5xx/network/timeouts do.
INTERACTIVE_RETRIES=3
INTERACTIVE_TIMEOUT_MS=45000
# Delay between retries (ms). RETRY_BACKOFF=1 makes it grow (attempt × delay).
RETRY_DELAY_MS=1000
RETRY_BACKOFF=0
# Times an unparsable DM turn is repaired before the turn is rolled back.
PARSE_RETRIES=3
# Max DM tool-calling steps per turn. Raise for very heavy combat.
MAX_TOOL_STEPS=16
# Characters (NOT tokens) of recent transcript sent to the DM each turn. Keep it
# well under the model's real limit — quality drops long before the ceiling.
MAX_CONTEXT_CHARS=250000


# ───────────────────────────────────────────────────────────────────────────
#  SECTION 7 — Table timing (defaults are fine)
# ───────────────────────────────────────────────────────────────────────────
# Idle deadline before an exploration round resolves / an idle combatant is skipped.
TURN_TIMEOUT_MS=90000
# A player counts as "away" this long after their phone last checked in.
PLAYER_AWAY_MS=20000
# How long the TV's heartbeat counts as live (controls the "waiting for the
# screen" banner and silent TV takeover).
HOST_SESSION_STALE_MS=15000
# How long a player must be gone before the DM writes them out of the scene
# (safely — never killed). Keep well above PLAYER_AWAY_MS.
DEPARTURE_WEAVE_GRACE_MS=120000
# A "the Weaver is thinking…" status older than this is treated as stuck (min 60000).
DM_STATUS_STALE_MS=300000


# ───────────────────────────────────────────────────────────────────────────
#  SECTION 8 — Debugging
# ───────────────────────────────────────────────────────────────────────────
# Server-log verbosity. Errors always print.
#   (empty) quiet   1 = tool calls, DM steps, game logic   2 = everything
DEBUG_VERBOSE=
