API_KEY=
BASE_URL=https://api.aquadevs.com/v1
CHAT_MODEL=hy3
IMAGE_MODEL=nanobanana-pro
# Optional: image model on a DIFFERENT OpenAI-compatible provider. Leave BOTH
# empty to reuse BASE_URL / API_KEY (same provider as the chat model). Each
# falls back independently, so you can override just the URL.
IMAGE_BASE_URL=
IMAGE_API_KEY=
# Background image jobs never block narration. After this many failed attempts
# the asset is skipped and the story continues (defaults: 3 attempts, 60s each).
# A permanent 4xx (bad model, bad request, auth) fails on the first attempt
# regardless — only transient errors use the attempts above.
IMAGE_RETRIES=3
IMAGE_TIMEOUT_MS=60000
# Framing is automatic and needs no configuration: scene backdrops are
# requested widescreen (1344x768), portraits tall (768x1344). If the provider
# rejects the `size` parameter with a 400, that one request is retried unsized
# and `size` is dropped for the rest of the process — see src/lib/aqua/images.ts.

# ── Named narration targets (manual host switching after a failure) ──────
# The host can manually switch the narration model/provider from the
# Director's Drawer when the current target fails. Targets are resolved
# SERVER-SIDE from these variables — the campaign JSON stores only the alias,
# NEVER credentials. The default target is always CHAT_MODEL/BASE_URL/API_KEY.
#
# Declare additional targets with a numbered prefix (1..20). Each needs at
# least an ALIAS and a MODEL; BASE_URL and API_KEY fall back to the main
# endpoint when left empty. LABEL is what the host selector shows.
#
#   CHAT_TARGET_1_ALIAS=gemini
#   CHAT_TARGET_1_MODEL=gemini-3.6
#   CHAT_TARGET_1_BASE_URL=https://...
#   CHAT_TARGET_1_API_KEY=...
#   CHAT_TARGET_1_LABEL=Gemini 3.6
#   CHAT_TARGET_1_TOOLS=0
#
# CHAT_TARGET_N_TOOLS=0 declares that a target CANNOT do tool/function calling.
# Narration is entirely tool-driven (narrate_turn ends every turn, and all state
# changes go through tools), so such a target is refused when the host tries to
# switch to it — instead of accepting the switch and failing every turn with a
# 400 "does not support tools". Omit it (or use 1) for normal targets; most
# OpenAI-compatible endpoints support tools, so that is the default assumption.
# CHAT_TARGET_DEFAULT_TOOLS=0 says the same about the default CHAT_MODEL target.
#
# Switching is MANUAL ONLY — a failed provider is never auto-failed-over. The
# host sees the failure in the Director's Drawer and picks a new target; the
# next retry/turn uses it. See src/lib/aqua/client.ts resolveChatTarget().
#
# Editing this file is NOT the live switching mechanism. A dev-server .env
# reload has no defined effect on a request already in flight, and it changes
# every campaign at once. To move a running campaign to another provider, use
# the party leader's Host tab (phone) — that persists the choice per campaign.
CHAT_TARGET_DEFAULT_LABEL=

# Optional small/fast model for HOUSEKEEPING ONLY: compacting old transcript
# into a running summary, trimming memory, and flagging duplicate/stale NPCs so
# the large RP model never suffers context collapse. It never directs live
# narration, ambience, effects, or backdrops — those always run on
# CHAT_MODEL. Empty = housekeeping is skipped (the char budget below is
# the only safety net).
FAST_MODEL=

# Optional: host the small model on a DIFFERENT OpenAI-compatible provider.
# Leave BOTH empty to reuse BASE_URL / API_KEY (same provider as the
# large model). Each falls back independently, so you can override just the URL.
FAST_BASE_URL=
FAST_API_KEY=
# Housekeeping is also best-effort. Bound an unstable provider so compaction is
# skipped rather than retrying indefinitely (defaults: 3 attempts, 45s each).
HOUSEKEEPING_RETRIES=3
HOUSEKEEPING_TIMEOUT_MS=45000
# Cross-turn suppression so a broken housekeeping provider isn't re-attempted
# every single turn. After this many consecutive failures on UNCHANGED input
# (same message count / memory size / NPC count), sweeps stop until the input
# materially changes or the party leader forces a retry from their phone
# (default 5, minimum 1).
HOUSEKEEPING_MAX_CONSECUTIVE_FAILURES=5
# After ANY failed sweep, wait this long before retrying the SAME input. New
# messages/NPCs override the cooldown and try immediately; a manual retry
# clears it outright (default 300000 = 5 min, minimum 30000).
HOUSEKEEPING_FAILURE_COOLDOWN_MS=300000

# Server-log verbosity (off by default so the console isn't flooded). Errors
# always print regardless.
#   1 = tool calls, DM steps, and game logic
#   2 = everything, including the noisy per-request "API …" logs
DEBUG_VERBOSE=

# Turn/round idle deadline in ms (default 90000). Past it, the host nudges the
# server to resolve an exploration round or skip an idle combatant.
TURN_TIMEOUT_MS=90000
# A player is considered "away" this long after their last controller poll (ms).
PLAYER_AWAY_MS=20000
# How long (ms) a TV/Host screen's heartbeat stays "live" after its last poll.
# Governs both the controllers' "waiting for the screen" banner and how long a
# closed TV must be gone before a freshly opened one claims the session with no
# takeover prompt (default 15000).
HOST_SESSION_STALE_MS=15000
# How long (ms) a player must stay disconnected before the DM writes their
# departure into the story (parks them safely, never kills them). Kept well
# above PLAYER_AWAY_MS so a slow-loading phone at session resume never triggers
# an in-fiction exit for what's really just a brief reconnect (default 2 min).
DEPARTURE_WEAVE_GRACE_MS=120000
# Max DM tool-calling steps per turn (default 16). Raise for very heavy combat.
MAX_TOOL_STEPS=16
# Interactive DM-turn network retries + per-attempt timeout (fail fast so a dead
# endpoint surfaces in seconds, not minutes).
#
# BOTH are clamped in code (src/lib/aqua/client.ts): retries to at most 10
# (MAX_RETRIES_HARD_CAP) and the per-attempt timeout to at most 600000ms
# (MAX_TIMEOUT_HARD_CAP_MS). A value above either cap is silently reduced —
# an "attempt 1/1000" turn, or a single attempt hanging for hours on a wedged
# socket, are both configuration mistakes rather than useful settings.
#
# Permanent failures are never retried at all regardless of these values: a 4xx
# that cannot recover (unsupported tools, invalid model, bad schema, auth) fails
# on the first attempt. Only 408/429/5xx/network/timeout errors retry.
INTERACTIVE_RETRIES=3
INTERACTIVE_TIMEOUT_MS=45000
# Wait this long between retries on 5xx/429/network errors (ms). Unstable APIs
# that just need hammering should use a short fixed delay (e.g. 1000).
RETRY_DELAY_MS=1000
# 0 = fixed delay every retry (default). 1 = linear backoff (attempt * delay).
RETRY_BACKOFF=0
# If a turn's final response can't be parsed into JSON, retry this many times
# by forcing the narrate_turn tool call before giving up and rolling the turn
# back (default 3).
PARSE_RETRIES=3
# Those forced-narrate_turn retries are pure reformatting of a turn the large
# model already decided (no new creative content), so when FAST_MODEL is
# configured they route there by default — cheaper/faster than re-running the
# whole conversation through the large model. Set to 0 to always retry with
# CHAT_MODEL instead, e.g. if the small model starts altering the narration
# instead of just repackaging it.
PARSE_RETRY_USE_FAST_MODEL=1
# Max characters (NOT tokens) of recent transcript fed to the DM each turn. The
# chat model supports up to ~1M tokens of context, but quality degrades well
# before that ceiling, so keep this well under the model's true limit.
MAX_CONTEXT_CHARS=250000
