# Git LFS tracks the large music libraries only. Git attributes cannot filter
# by a file-size threshold, so short SFX and TTS voice samples remain normal
# Git files while the multi-gigabyte ambience/BGM catalogs stay in LFS.
public/music/AMBIENCE/*.mp3 filter=lfs diff=lfs merge=lfs -text
public/music/BGM/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
